<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NASA Space Apps - Planetary Mission Control | Dual-Globe Explorer</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
  <script src="data/mission_dataset.js"></script>
  <style>
    :root {
      --bg: #040711;
      --panel-bg: rgba(10, 16, 32, 0.92);
      --card-bg: rgba(16, 26, 48, 0.75);
      --border: rgba(45, 66, 110, 0.65);
      --border-bright: rgba(0, 242, 254, 0.5);
      --accent: #00f2fe;
      --accent-glow: rgba(0, 242, 254, 0.35);
      --mars-color: #f97316;
      --mars-glow: rgba(249, 115, 22, 0.4);
      --moon-color: #cbd5e1;
      --moon-glow: rgba(203, 213, 225, 0.35);
      --bolivia-gold: #fbbf24;
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --success: #22c55e;
      --warning: #eab308;
      --danger: #ef4444;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      overflow: hidden;
      height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* TOP HEADER & CONTROL BAR */
    header {
      background: rgba(6, 10, 22, 0.96);
      border-bottom: 1px solid var(--border);
      padding: 0.5rem 1.2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      z-index: 100;
      backdrop-filter: blur(12px);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .brand-logo {
      width: 38px;
      height: 38px;
      background: radial-gradient(circle, #38bdf8 0%, #0284c7 100%);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 900;
      font-size: 1.05rem;
      color: white;
      box-shadow: 0 0 16px var(--accent-glow);
      letter-spacing: -0.5px;
    }

    .brand h1 {
      font-size: 1.05rem;
      letter-spacing: -0.3px;
      line-height: 1.2;
    }

    .brand span {
      font-size: 0.72rem;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.8px;
    }

    /* SEARCH & FILTER CONTROLS */
    .controls-center {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .search-box {
      position: relative;
      width: 260px;
    }

    .search-box input {
      width: 100%;
      background: rgba(18, 28, 52, 0.85);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 0.4rem 1rem 0.4rem 2.2rem;
      color: white;
      font-size: 0.82rem;
      outline: none;
      transition: all 0.2s;
    }

    .search-box input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 12px var(--accent-glow);
      background: rgba(22, 36, 68, 0.95);
    }

    .search-icon {
      position: absolute;
      left: 0.75rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      font-size: 0.85rem;
      pointer-events: none;
    }

    .filter-pills {
      display: flex;
      gap: 0.35rem;
    }

    .pill-btn {
      background: rgba(30, 41, 59, 0.75);
      border: 1px solid var(--border);
      color: var(--text-muted);
      padding: 0.32rem 0.7rem;
      border-radius: 15px;
      font-size: 0.72rem;
      cursor: pointer;
      font-weight: 500;
      transition: all 0.2s;
    }

    .pill-btn:hover, .pill-btn.active {
      background: var(--accent);
      color: #040814;
      border-color: var(--accent);
      font-weight: 700;
      box-shadow: 0 0 10px var(--accent-glow);
    }

    .pill-bolivia {
      border-color: rgba(251, 191, 36, 0.6);
      color: #fbbf24;
      background: rgba(251, 191, 36, 0.12);
    }

    .pill-bolivia:hover, .pill-bolivia.active {
      background: linear-gradient(135deg, #ef4444, #f59e0b, #10b981);
      color: white;
      border-color: #f59e0b;
      box-shadow: 0 0 14px rgba(245, 158, 11, 0.6);
    }

    /* PLANET TOGGLE (MARS / MOON) */
    .planet-selector {
      display: flex;
      background: rgba(14, 21, 38, 0.9);
      border: 1px solid var(--border);
      border-radius: 25px;
      padding: 0.2rem;
    }

    .planet-btn {
      padding: 0.35rem 0.85rem;
      border-radius: 20px;
      border: none;
      font-size: 0.78rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      color: var(--text-muted);
      background: transparent;
      transition: all 0.25s;
    }

    .planet-btn.active.mars-btn {
      background: var(--mars-color);
      color: white;
      box-shadow: 0 0 14px var(--mars-glow);
    }

    .planet-btn.active.moon-btn {
      background: var(--moon-color);
      color: #040814;
      box-shadow: 0 0 14px var(--moon-glow);
    }

    /* MAIN DUAL GLOBE CONTAINER */
    #dual-globes-container {
      flex: 1;
      display: flex;
      position: relative;
      overflow: hidden;
      background: radial-gradient(circle at 50% 50%, #070e22 0%, #03050a 100%);
    }

    .globe-viewport {
      flex: 1;
      height: 100%;
      position: relative;
    }

    .globe-canvas-wrapper {
      width: 100%;
      height: 100%;
    }

    .viewport-overlay {
      position: absolute;
      top: 1rem;
      left: 1.5rem;
      pointer-events: none;
      z-index: 10;
      text-shadow: 0 2px 10px rgba(0,0,0,0.8);
    }

    .viewport-overlay h2 {
      font-size: 1.15rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .viewport-overlay p {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-top: 0.2rem;
    }

    .divider-line {
      position: absolute;
      left: 50%;
      top: 0;
      bottom: 0;
      width: 2px;
      background: linear-gradient(180deg, transparent, var(--border), var(--accent), var(--border), transparent);
      z-index: 20;
      pointer-events: none;
    }

    /* FLOATING ON-GLOBE CALLOUT */
    #globe-pin-callout {
      position: absolute;
      background: rgba(9, 15, 30, 0.95);
      border: 1px solid var(--accent);
      border-radius: 8px;
      padding: 0.5rem;
      z-index: 40;
      display: none;
      pointer-events: auto;
      box-shadow: 0 8px 25px rgba(0, 242, 254, 0.35);
      backdrop-filter: blur(10px);
      width: 240px;
      transform: translate(-50%, -100%) translateY(-15px);
      animation: calloutPop 0.25s ease-out;
    }

    @keyframes calloutPop {
      0% { opacity: 0; transform: translate(-50%, -90%) scale(0.9); }
      100% { opacity: 1; transform: translate(-50%, -100%) translateY(-15px) scale(1); }
    }

    #globe-pin-callout::after {
      content: "";
      position: absolute;
      bottom: -8px;
      left: 50%;
      transform: translateX(-50%);
      border-width: 8px 8px 0;
      border-style: solid;
      border-color: var(--accent) transparent;
      display: block;
      width: 0;
    }

    .callout-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 0.4rem;
    }

    .callout-title {
      font-size: 0.85rem;
      font-weight: 700;
      color: white;
      line-height: 1.2;
    }

    .callout-close {
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-size: 1rem;
      cursor: pointer;
      line-height: 1;
      padding: 0 0.2rem;
    }
    .callout-close:hover { color: white; }

    .callout-body {
      display: flex;
      gap: 0.5rem;
      align-items: center;
    }

    .callout-thumb {
      width: 58px;
      height: 58px;
      border-radius: 4px;
      object-fit: cover;
      border: 1px solid var(--border);
      background: #000;
      cursor: pointer;
    }

    .callout-info {
      flex: 1;
      font-size: 0.7rem;
      color: var(--text-muted);
    }

    .callout-btn {
      margin-top: 0.4rem;
      width: 100%;
      background: linear-gradient(135deg, rgba(0,242,254,0.2), rgba(2,132,199,0.3));
      border: 1px solid var(--accent);
      color: white;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.3rem 0.5rem;
      border-radius: 4px;
      cursor: pointer;
      transition: all 0.2s;
      text-align: center;
    }
    .callout-btn:hover {
      background: var(--accent);
      color: #040814;
    }

    /* BOTTOM INTELLIGENCE HUD */
    #mission-hud {
      height: 310px;
      background: var(--panel-bg);
      border-top: 1px solid var(--border);
      backdrop-filter: blur(15px);
      z-index: 50;
      display: flex;
      flex-direction: column;
      transition: transform 0.3s ease;
    }

    .hud-header {
      padding: 0.45rem 1.2rem;
      background: rgba(8, 13, 26, 0.98);
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .hud-title {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .hud-grid {
      flex: 1;
      display: grid;
      grid-template-columns: 1.15fr 1.15fr 260px 1.1fr;
      overflow-y: auto;
      gap: 1px;
      background: var(--border);
    }

    .hud-column {
      background: var(--panel-bg);
      padding: 0.75rem 1rem;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
    }

    .hud-col-header {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-muted);
      margin-bottom: 0.4rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      padding-bottom: 0.3rem;
    }

    .site-title {
      font-size: 1.1rem;
      font-weight: 800;
      margin-bottom: 0.2rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .site-badge {
      font-size: 0.68rem;
      padding: 0.15rem 0.5rem;
      border-radius: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .badge-bolivia-gem {
      background: linear-gradient(135deg, #ef4444, #f59e0b, #10b981);
      color: white;
      box-shadow: 0 0 8px rgba(245, 158, 11, 0.4);
    }

    .badge-mars {
      background: var(--mars-color);
      color: white;
    }

    .badge-moon {
      background: var(--moon-color);
      color: #040814;
    }

    /* SITE MAP VISUALIZER CARD (NEW) */
    .site-map-card {
      margin-top: 0.4rem;
      margin-bottom: 0.5rem;
      background: rgba(12, 19, 38, 0.8);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.4rem;
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }

    .site-map-card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .map-tabs {
      display: flex;
      gap: 0.25rem;
    }

    .map-tab-btn {
      background: rgba(30, 41, 59, 0.8);
      border: 1px solid rgba(255,255,255,0.1);
      color: var(--text-muted);
      font-size: 0.65rem;
      font-weight: 600;
      padding: 0.18rem 0.45rem;
      border-radius: 4px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .map-tab-btn.active, .map-tab-btn:hover {
      background: var(--accent);
      color: #040814;
      font-weight: 700;
    }

    .map-preview-box {
      position: relative;
      height: 95px;
      border-radius: 4px;
      overflow: hidden;
      cursor: pointer;
      border: 1px solid rgba(255,255,255,0.1);
      background: #000;
    }

    .map-preview-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s;
    }

    .map-preview-box:hover img {
      transform: scale(1.05);
    }

    .map-overlay-badge {
      position: absolute;
      bottom: 4px;
      left: 4px;
      background: rgba(0, 0, 0, 0.75);
      border: 1px solid rgba(255,255,255,0.2);
      padding: 0.12rem 0.4rem;
      border-radius: 3px;
      font-size: 0.62rem;
      font-weight: 600;
      color: #e2e8f0;
      backdrop-filter: blur(4px);
    }

    .map-overlay-zoom {
      position: absolute;
      top: 4px;
      right: 4px;
      background: rgba(0, 242, 254, 0.85);
      color: #040814;
      padding: 0.15rem 0.4rem;
      border-radius: 3px;
      font-size: 0.62rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      gap: 0.25rem;
      box-shadow: 0 0 8px rgba(0,242,254,0.5);
    }

    .data-row {
      margin-bottom: 0.35rem;
      font-size: 0.76rem;
    }

    .data-label {
      color: var(--text-muted);
      font-size: 0.68rem;
      text-transform: uppercase;
      margin-bottom: 0.08rem;
    }

    .data-value {
      color: #e2e8f0;
      line-height: 1.3;
    }

    /* PSI MATCH BOX */
    .psi-meter-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 0.5rem;
    }

    .psi-circle {
      width: 95px;
      height: 95px;
      border-radius: 50%;
      background: conic-gradient(var(--accent) 0deg, var(--accent) 270deg, rgba(255,255,255,0.1) 270deg);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 0.5rem;
      box-shadow: 0 0 15px var(--accent-glow);
      transition: background 0.3s;
    }

    .psi-inner {
      width: 74px;
      height: 74px;
      border-radius: 50%;
      background: #080d1b;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .psi-number {
      font-size: 1.45rem;
      font-weight: 900;
      color: white;
      line-height: 1;
    }

    .psi-sub {
      font-size: 0.62rem;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .subscore-bar {
      width: 100%;
      margin: 0.2rem 0;
      font-size: 0.68rem;
    }

    .bar-track {
      width: 100%;
      height: 5px;
      background: rgba(255,255,255,0.1);
      border-radius: 3px;
      overflow: hidden;
      margin-top: 2px;
    }

    .bar-fill {
      height: 100%;
      background: var(--accent);
      border-radius: 3px;
      transition: width 0.3s;
    }

    /* MISSION GEAR LIST */
    .gear-list {
      list-style: none;
      padding: 0;
    }

    .gear-item {
      font-size: 0.72rem;
      margin-bottom: 0.3rem;
      display: flex;
      gap: 0.4rem;
      align-items: flex-start;
      color: #cbd5e1;
      line-height: 1.3;
    }

    .gear-bullet {
      color: var(--accent);
      font-weight: 900;
    }

    /* FULL MODAL INSPECTOR */
    #site-modal {
      position: fixed;
      inset: 0;
      background: rgba(4, 7, 16, 0.85);
      backdrop-filter: blur(12px);
      z-index: 1000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }

    .modal-box {
      background: #0a1020;
      border: 1px solid var(--accent);
      box-shadow: 0 0 35px rgba(0, 242, 254, 0.25);
      border-radius: 10px;
      width: 1000px;
      max-width: 95vw;
      max-height: 90vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      animation: modalFadeIn 0.25s ease-out;
    }

    @keyframes modalFadeIn {
      0% { opacity: 0; transform: scale(0.95); }
      100% { opacity: 1; transform: scale(1); }
    }

    .modal-header {
      background: rgba(14, 23, 45, 0.95);
      border-bottom: 1px solid var(--border);
      padding: 0.8rem 1.4rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .modal-title-group h3 {
      font-size: 1.25rem;
      font-weight: 800;
      color: white;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .modal-title-group p {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-top: 0.15rem;
    }

    .modal-close-btn {
      background: rgba(255,255,255,0.1);
      border: 1px solid var(--border);
      color: white;
      font-size: 1.2rem;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
    }
    .modal-close-btn:hover {
      background: var(--danger);
      border-color: var(--danger);
    }

    .modal-body {
      flex: 1;
      display: grid;
      grid-template-columns: 1fr 1fr;
      overflow-y: auto;
      gap: 1.2rem;
      padding: 1.2rem;
    }

    .modal-viewer-col {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }

    .modal-tabs {
      display: flex;
      gap: 0.4rem;
    }

    .modal-tab-btn {
      background: rgba(30, 41, 59, 0.7);
      border: 1px solid var(--border);
      color: var(--text-muted);
      padding: 0.4rem 0.8rem;
      border-radius: 6px;
      font-size: 0.75rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
    }

    .modal-tab-btn.active, .modal-tab-btn:hover {
      background: var(--accent);
      color: #040814;
      border-color: var(--accent);
    }

    .modal-img-container {
      position: relative;
      background: #000;
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
      aspect-ratio: 1 / 1;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: inset 0 0 20px rgba(0,0,0,0.8);
    }

    .modal-img-container img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.2s ease-out;
    }

    .modal-legend-bar {
      background: rgba(14, 22, 42, 0.9);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.5rem 0.8rem;
      font-size: 0.72rem;
    }

    .legend-colors {
      display: flex;
      gap: 0.8rem;
      margin-top: 0.3rem;
      align-items: center;
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.7rem;
    }

    .legend-color-dot {
      width: 10px;
      height: 10px;
      border-radius: 2px;
    }

    .modal-info-col {
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
      font-size: 0.8rem;
      overflow-y: auto;
    }

    .modal-section-card {
      background: rgba(14, 22, 42, 0.7);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.8rem;
    }

    .modal-section-title {
      font-size: 0.75rem;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--accent);
      margin-bottom: 0.4rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      padding-bottom: 0.3rem;
    }

    /* TOOLTIP */
    #globe-tooltip {
      position: absolute;
      background: rgba(10, 16, 32, 0.95);
      border: 1px solid var(--accent);
      color: white;
      padding: 0.4rem 0.8rem;
      border-radius: 6px;
      font-size: 0.75rem;
      pointer-events: none;
      display: none;
      z-index: 1000;
      box-shadow: 0 4px 15px rgba(0, 242, 254, 0.3);
    }
  </style>
</head>
<body>

  <!-- TOP BAR -->
  <header>
    <div class="brand">
      <div class="brand-logo">NASA</div>
      <div>
        <h1>PLANETARY MISSION CONTROL <span style="font-size:0.8rem; color:#f59e0b;">| BEYOND KNOWN ANALOGUES</span></h1>
        <span>Bolivia Altiplano & Global Earth Analogs ◄► Mars & Moon Bases</span>
      </div>
    </div>

    <!-- SEARCH & REGION FILTER -->
    <div class="controls-center">
      <div class="search-box">
        <span class="search-icon">🔍</span>
        <input type="text" id="region-search" placeholder="Buscar análogo, país o misión...">
      </div>
      <div class="filter-pills">
        <button class="pill-btn pill-bolivia active" data-filter="bolivia">🇧🇴 Bolivia (5 Gemas)</button>
        <button class="pill-btn" data-filter="all">Todos los Análogos</button>
        <button class="pill-btn" data-filter="sal">Evaporitas / Sal</button>
