  <!-- FLOATING TOOLTIP -->
  <div id="globe-tooltip"></div>

  <!-- CORE THREE.JS DUAL GLOBE & INTERACTION LOGIC -->
  <script>
    const DB = window.PLANETARY_MISSION_DATA || {
      earth_analogs: [],
      mars_sites: {},
      moon_sites: {}
    };

    let activeTargetPlanet = "mars"; // "mars" or "moon"
    let selectedEarthAnalog = DB.earth_analogs && DB.earth_analogs[0] ? DB.earth_analogs[0] : null;
    let selectedTargetSite = DB.mars_sites && DB.mars_sites["jezero_crater"] ? DB.mars_sites["jezero_crater"] : null;

    let activeEarthMapType = "satellite"; // "satellite", "heightmap", "slopemap"
    let activeTargetMapType = "satellite";
    let modalCurrentSite = null; // object of active site in modal
    let modalCurrentType = "earth"; // "earth" or "target"
    let modalCurrentMap = "satellite";

    // --- THREE.JS GLOBE SETUP ---
    let sceneEarth, cameraEarth, rendererEarth, controlsEarth, globeEarth, globeEarthClouds, earthPinsGroup;
    let sceneTarget, cameraTarget, rendererTarget, controlsTarget, globeTarget, targetPinsGroup;
    let earthPulseRings = [], targetPulseRings = [];
    const raycaster = new THREE.Raycaster();
    const mouse = new THREE.Vector2();
    const textureLoader = new THREE.TextureLoader();
    textureLoader.setCrossOrigin("anonymous");

    let lastClickedPinData = null;
    let lastClickedPinType = "earth";
    let lastClickedPos3D = null;

    function initDualGlobes() {
      // 1. EARTH GLOBE
      const earthContainer = document.getElementById("canvas-earth");
      sceneEarth = new THREE.Scene();
      cameraEarth = new THREE.PerspectiveCamera(45, earthContainer.clientWidth / earthContainer.clientHeight, 0.1, 1000);
      cameraEarth.position.set(0, 0, 240);

      rendererEarth = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      rendererEarth.setSize(earthContainer.clientWidth, earthContainer.clientHeight);
      rendererEarth.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      earthContainer.appendChild(rendererEarth.domElement);

      controlsEarth = new THREE.OrbitControls(cameraEarth, rendererEarth.domElement);
      controlsEarth.enableDamping = true;
      controlsEarth.dampingFactor = 0.05;
      controlsEarth.minDistance = 110;
      controlsEarth.maxDistance = 380;

      // Realistic Space Lighting (Earth) - Calibrated to reveal vibrant continents & oceans
      const ambLightEarth = new THREE.AmbientLight(0xffffff, 0.48);
      sceneEarth.add(ambLightEarth);
      const sunLightEarth = new THREE.DirectionalLight(0xffffff, 1.25);
      sunLightEarth.position.set(160, 90, 160);
      sceneEarth.add(sunLightEarth);
      const rimLightEarth = new THREE.DirectionalLight(0x38bdf8, 0.35);
      rimLightEarth.position.set(-160, -40, -160);
      sceneEarth.add(rimLightEarth);

      // Deep Space Starfield
      createStarfield(sceneEarth);

      // Create Realistic Earth Sphere
      const earthGeo = new THREE.SphereGeometry(70, 64, 64);
      const earthMat = new THREE.MeshPhongMaterial({
        map: createRealisticEarthTexture(),
        bumpScale: 1.2,
        specular: new THREE.Color(0x0e2a4a),
        shininess: 12
      });
      globeEarth = new THREE.Mesh(earthGeo, earthMat);
      sceneEarth.add(globeEarth);

      // Try loading NASA 2K Blue Marble texture asynchronously
      textureLoader.load(
        "https://unpkg.com/three-globe/example/img/earth-blue-marble.jpg",
        (tex) => {
          globeEarth.material.map = tex;
          globeEarth.material.needsUpdate = true;
        },
        undefined,
        () => console.log("Using high-fidelity procedural Earth texture")
      );

      // Independent Clouds Sphere Layer (Subtle wisps)
      const cloudGeo = new THREE.SphereGeometry(70.8, 64, 64);
      const cloudMat = new THREE.MeshPhongMaterial({
        map: createProceduralCloudsTexture(),
        transparent: true,
        opacity: 0.22,
        blending: THREE.AdditiveBlending
      });
      globeEarthClouds = new THREE.Mesh(cloudGeo, cloudMat);
      sceneEarth.add(globeEarthClouds);

      // Atmospheric Blue Rim Glow
      const earthAtmoGeo = new THREE.SphereGeometry(72.8, 64, 64);
      const earthAtmoMat = new THREE.MeshBasicMaterial({
        color: 0x00f2fe,
        transparent: true,
        opacity: 0.16,
        side: THREE.BackSide,
        blending: THREE.AdditiveBlending
      });
      sceneEarth.add(new THREE.Mesh(earthAtmoGeo, earthAtmoMat));

      earthPinsGroup = new THREE.Group();
      globeEarth.add(earthPinsGroup);
      populateEarthPins();

      // 2. TARGET GLOBE (MARS / MOON)
      const targetContainer = document.getElementById("canvas-target");
      sceneTarget = new THREE.Scene();
      cameraTarget = new THREE.PerspectiveCamera(45, targetContainer.clientWidth / targetContainer.clientHeight, 0.1, 1000);
      cameraTarget.position.set(0, 0, 240);

      rendererTarget = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      rendererTarget.setSize(targetContainer.clientWidth, targetContainer.clientHeight);
      rendererTarget.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      targetContainer.appendChild(rendererTarget.domElement);

      controlsTarget = new THREE.OrbitControls(cameraTarget, rendererTarget.domElement);
      controlsTarget.enableDamping = true;
      controlsTarget.dampingFactor = 0.05;
      controlsTarget.minDistance = 110;
      controlsTarget.maxDistance = 380;

      // Realistic Space Lighting (Target) - Calibrated to prevent white blowout
      const ambLightTarget = new THREE.AmbientLight(0xffffff, 0.42);
      ambLightTarget.name = "target-amb-light";
      sceneTarget.add(ambLightTarget);
      const sunLightTarget = new THREE.DirectionalLight(0xfff8ee, 1.15);
      sunLightTarget.position.set(160, 90, 160);
      sceneTarget.add(sunLightTarget);
      const rimLightTarget = new THREE.DirectionalLight(0xf97316, 0.25);
      rimLightTarget.name = "target-rim-light";
      rimLightTarget.position.set(-160, -40, -160);
      sceneTarget.add(rimLightTarget);

      // Deep Space Starfield
      createStarfield(sceneTarget);

      // Create Target Planet Sphere (Default Mars)
      const targetGeo = new THREE.SphereGeometry(70, 64, 64);
      const targetMat = new THREE.MeshPhongMaterial({
        map: createRealisticMarsTexture(),
        bumpScale: 1.8,
        specular: new THREE.Color(0x331100),
        shininess: 4
      });
      globeTarget = new THREE.Mesh(targetGeo, targetMat);
      sceneTarget.add(globeTarget);

      // Mars atmospheric rim haze
      const targetAtmoGeo = new THREE.SphereGeometry(72.2, 64, 64);
      const targetAtmoMat = new THREE.MeshBasicMaterial({
        color: 0xf97316,
        transparent: true,
        opacity: 0.14,
        side: THREE.BackSide,
        blending: THREE.AdditiveBlending
      });
      const targetAtmoMesh = new THREE.Mesh(targetAtmoGeo, targetAtmoMat);
      targetAtmoMesh.name = "target-atmo-mesh";
      sceneTarget.add(targetAtmoMesh);

      // Try loading NASA Mars texture asynchronously
      textureLoader.load(
        "https://raw.githubusercontent.com/mrdoob/three.js/master/examples/textures/planets/mars_1k_color.jpg",
        (tex) => {
          if (activeTargetPlanet === "mars") {
            globeTarget.material.map = tex;
            globeTarget.material.needsUpdate = true;
          }
        },
        undefined,
        () => console.log("Using procedural Mars texture")
      );

      targetPinsGroup = new THREE.Group();
      globeTarget.add(targetPinsGroup);
      populateTargetPins();

      // Window resize
      window.addEventListener("resize", onWindowResize);

      // Raycasting click & hover
      rendererEarth.domElement.addEventListener("pointerdown", (e) => handleGlobeClick(e, "earth"));
      rendererTarget.domElement.addEventListener("pointerdown", (e) => handleGlobeClick(e, "target"));
      rendererEarth.domElement.addEventListener("pointermove", (e) => handleGlobeHover(e, "earth"));
      rendererTarget.domElement.addEventListener("pointermove", (e) => handleGlobeHover(e, "target"));

      // Setup initial view focus on Bolivia
      focusEarthOnCoords(-20.13, -67.49);
      setupMapTabHandlers();
      updateHUD();
      animate();
    }

    // --- DEEP SPACE STARFIELD GENERATOR ---
    function createStarfield(scene) {
      const starGeo = new THREE.BufferGeometry();
      const starCount = 1200;
      const positions = new Float32Array(starCount * 3);
      for (let i = 0; i < starCount * 3; i += 3) {
        const u = Math.random();
        const v = Math.random();
        const theta = u * 2.0 * Math.PI;
        const phi = Math.acos(2.0 * v - 1.0);
        const r = 500 + Math.random() * 300;
        positions[i] = r * Math.sin(phi) * Math.cos(theta);
        positions[i + 1] = r * Math.sin(phi) * Math.sin(theta);
        positions[i + 2] = r * Math.cos(phi);
      }
      starGeo.setAttribute("position", new THREE.BufferAttribute(positions, 3));
      const starMat = new THREE.PointsMaterial({
        color: 0xffffff,
        size: 1.4,
        transparent: true,
        opacity: 0.85
      });
      const starField = new THREE.Points(starGeo, starMat);
      scene.add(starField);
    }

    // --- HIGH-FIDELITY PROCEDURAL TEXTURES (ALIGNED TO REAL GEOGRAPHY) ---

    // 1. REALISTIC EARTH PROCEDURAL TEXTURE (2048 x 1024 Equirectangular)
    function createRealisticEarthTexture() {
      const canvas = document.createElement("canvas");
      canvas.width = 2048;
      canvas.height = 1024;
      const ctx = canvas.getContext("2d");

      // Deep Ocean Base with Depth Gradient - Vibrant Blue Marble Palette
      const oceanGrad = ctx.createLinearGradient(0, 0, 0, canvas.height);
      oceanGrad.addColorStop(0, "#0e3a68");
      oceanGrad.addColorStop(0.25, "#0b2e54");
      oceanGrad.addColorStop(0.5, "#082342");
      oceanGrad.addColorStop(0.75, "#0b2e54");
      oceanGrad.addColorStop(1, "#0e3a68");
      ctx.fillStyle = oceanGrad;
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Function to draw landmass with turquoise coastal shelf
      function drawContinent(paths, fillColor, shelfColor = "#0284c7") {
        ctx.save();
        // Coastal shelf glow
        ctx.strokeStyle = shelfColor;
        ctx.lineWidth = 18;
        ctx.lineJoin = "round";
        ctx.beginPath();
        paths();
        ctx.stroke();

        // Land fill
        ctx.fillStyle = fillColor;
        ctx.fill();
        ctx.restore();
      }

      // SOUTH AMERICA (Real coordinates: lng -82° to -34°, lat 12° to -55°)
      drawContinent(() => {
        ctx.moveTo(560, 470);
        ctx.lineTo(610, 460); // Colombia / Venezuela
        ctx.lineTo(670, 490); // Guianas
        ctx.lineTo(760, 530); // Brazil North
        ctx.lineTo(820, 590); // Brazil East (Recife)
        ctx.lineTo(790, 680); // Rio de Janeiro
        ctx.lineTo(710, 780); // Buenos Aires / Rio de la Plata
        ctx.lineTo(670, 860); // Patagonia
        ctx.lineTo(650, 890); // Tierra del Fuego
        ctx.lineTo(630, 820); // Chile South
        ctx.lineTo(615, 680); // Chile / Atacama coast
        ctx.lineTo(580, 560); // Peru coast
        ctx.lineTo(550, 510); // Ecuador
        ctx.closePath();
      }, "#15803d", "#0ea5e9");

      // Amazon Basin (Lush Emerald Rainforest)
      ctx.fillStyle = "#166534";
      ctx.beginPath();
      ctx.ellipse(680, 550, 85, 52, -0.1, 0, Math.PI * 2);
      ctx.fill();

      // Andes Mountain Range (Brown/Ochre Spine along Pacific coast)
      ctx.fillStyle = "#92400e";
      ctx.beginPath();
      ctx.moveTo(570, 480);
      ctx.lineTo(580, 550);
      ctx.lineTo(615, 650);
      ctx.lineTo(630, 760);
      ctx.lineTo(650, 880);
      ctx.lineTo(640, 880);
      ctx.lineTo(610, 760);
      ctx.lineTo(595, 640);
      ctx.lineTo(560, 540);
      ctx.closePath();
      ctx.fill();

      // Salar de Uyuni & Bolivian Altiplano (Lat -20°, Lng -67.5° => x: 640, y: 626)
      ctx.fillStyle = "#eab308"; // Altiplano high plateau vibrant gold
      ctx.beginPath();
      ctx.ellipse(638, 626, 22, 32, 0.1, 0, Math.PI * 2);
      ctx.fill();

      // Brilliant White Salt Crust of Salar de Uyuni!
      ctx.fillStyle = "#ffffff";
      ctx.shadowColor = "#38bdf8";
      ctx.shadowBlur = 10;
      ctx.beginPath();
      ctx.arc(640, 626, 9, 0, Math.PI * 2);
      ctx.fill();
      ctx.shadowBlur = 0;

      // NORTH AMERICA
      drawContinent(() => {
        ctx.moveTo(180, 220); // Alaska
        ctx.lineTo(320, 180); // Northern Canada
        ctx.lineTo(460, 190); // Hudson Bay North
        ctx.lineTo(540, 240); // Labrador
        ctx.lineTo(510, 320); // Nova Scotia / East Coast
        ctx.lineTo(470, 380); // Florida
        ctx.lineTo(400, 390); // Gulf of Mexico
        ctx.lineTo(370, 460); // Mexico / Yucatan
        ctx.lineTo(440, 490); // Central America
        ctx.lineTo(320, 420); // Baja California
        ctx.lineTo(290, 320); // California
        ctx.lineTo(260, 260); // Pacific Northwest
        ctx.closePath();
      }, "#2d5a3f");

      // Rocky Mountains
      ctx.fillStyle = "#6b5843";
      ctx.beginPath();
      ctx.moveTo(270, 240);
      ctx.lineTo(340, 360);
      ctx.lineTo(320, 370);
      ctx.lineTo(250, 250);
      ctx.closePath();
      ctx.fill();

      // Greenland Ice Sheet
      ctx.fillStyle = "#f1f5f9";
      ctx.beginPath();
      ctx.ellipse(780, 130, 90, 60, -0.3, 0, Math.PI * 2);
      ctx.fill();

      // EURASIA & AFRICA
      drawContinent(() => {
        // Africa
        ctx.moveTo(980, 370); // Gibraltar
        ctx.lineTo(1120, 380); // Egypt / Sinai
        ctx.lineTo(1220, 440); // Horn of Africa
        ctx.lineTo(1180, 620); // East Africa
        ctx.lineTo(1100, 740); // South Africa (Cape of Good Hope)
        ctx.lineTo(1040, 660); // Namibia
        ctx.lineTo(990, 520); // Gulf of Guinea
        ctx.lineTo(920, 460); // West Africa (Senegal)
        ctx.lineTo(940, 380); // Morocco
        ctx.closePath();
      }, "#3a5a40");

      // Sahara Desert Golden Sands (North Africa)
      ctx.fillStyle = "#d97706";
      ctx.beginPath();
      ctx.ellipse(1040, 430, 110, 45, 0.05, 0, Math.PI * 2);
      ctx.fill();

      // Europe & Asia
      drawContinent(() => {
        ctx.moveTo(980, 350); // Spain
        ctx.lineTo(1010, 290); // France
        ctx.lineTo(1060, 200); // Scandinavia
        ctx.lineTo(1280, 180); // Siberia North
        ctx.lineTo(1680, 220); // Kamchatka
        ctx.lineTo(1620, 350); // China East
        ctx.lineTo(1480, 470); // Southeast Asia
        ctx.lineTo(1360, 480); // India
        ctx.lineTo(1240, 410); // Arabia
        ctx.lineTo(1140, 360); // Mediterranean
        ctx.closePath();
      }, "#344e41");

      // Himalayas Snow Peaks & Tibetan Plateau
      ctx.fillStyle = "#e2e8f0";
      ctx.beginPath();
      ctx.ellipse(1390, 370, 70, 20, 0.2, 0, Math.PI * 2);
      ctx.fill();

      // AUSTRALIA
      drawContinent(() => {
        ctx.moveTo(1670, 620); // Northwest
        ctx.lineTo(1760, 600); // Darwin / Gulf
        ctx.lineTo(1840, 640); // Queensland
        ctx.lineTo(1860, 740); // Sydney
        ctx.lineTo(1790, 780); // Melbourne
        ctx.lineTo(1690, 740); // Great Australian Bight
        ctx.closePath();
      }, "#b45309"); // Red ochre outback

      // ANTARCTICA (South Polar Continent)
      ctx.fillStyle = "#f8fafc";
      ctx.fillRect(0, 910, canvas.width, 114);

      return new THREE.CanvasTexture(canvas);
    }

    // 2. PROCEDURAL VOLUMETRIC CLOUDS TEXTURE
    function createProceduralCloudsTexture() {
      const canvas = document.createElement("canvas");
      canvas.width = 1024;
      canvas.height = 512;
      const ctx = canvas.getContext("2d");
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      ctx.fillStyle = "rgba(255, 255, 255, 0.45)";
      // Equatorial cloud band
      for (let i = 0; i < 40; i++) {
        const x = Math.random() * canvas.width;
        const y = 230 + (Math.random() - 0.5) * 80;
        const rx = 40 + Math.random() * 80;
        const ry = 15 + Math.random() * 30;
        ctx.beginPath();
        ctx.ellipse(x, y, rx, ry, (Math.random() - 0.5) * 0.4, 0, Math.PI * 2);
        ctx.fill();
      }
      // Temperate cyclonic swirls
      for (let i = 0; i < 30; i++) {
        const x = Math.random() * canvas.width;
        const y = (Math.random() > 0.5 ? 120 : 380) + (Math.random() - 0.5) * 60;
        ctx.beginPath();
        ctx.arc(x, y, 25 + Math.random() * 45, 0, Math.PI * 2);
        ctx.fill();
      }
      return new THREE.CanvasTexture(canvas);
    }

    // 3. REALISTIC MARS PROCEDURAL TEXTURE (2048 x 1024)
    function createRealisticMarsTexture() {
      const canvas = document.createElement("canvas");
      canvas.width = 2048;
      canvas.height = 1024;
      const ctx = canvas.getContext("2d");

      // Deep Rust-Ochre Base
      ctx.fillStyle = "#b85328";
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Organic Martian Soil Color Variations
      for (let i = 0; i < 50; i++) {
        const x = Math.random() * canvas.width;
        const y = Math.random() * canvas.height;
        const rad = 80 + Math.random() * 180;
        ctx.fillStyle = (Math.random() > 0.5) ? "rgba(154, 52, 18, 0.35)" : "rgba(234, 88, 12, 0.25)";
        ctx.beginPath();
        ctx.arc(x, y, rad, 0, Math.PI * 2);
        ctx.fill();
      }

      // Dark Basalt Albedo Features (Syrtis Major, Sinus Meridiani, Acidalia)
      ctx.fillStyle = "#4a1c10";
      // Syrtis Major (Prominent dark triangular shield)
      ctx.beginPath();
      ctx.moveTo(1420, 360);
      ctx.lineTo(1530, 480);
      ctx.lineTo(1410, 520);
      ctx.closePath();
      ctx.fill();

      // Sinus Meridiani & Acidalia Planitia
      ctx.beginPath();
      ctx.ellipse(980, 510, 160, 75, -0.1, 0, Math.PI * 2);
      ctx.ellipse(920, 340, 120, 90, 0, 0, Math.PI * 2);
      ctx.fill();

      // Valles Marineris (Colossal Grand Canyon of Mars along equator)
      ctx.strokeStyle = "#38120a";
      ctx.lineWidth = 14;
      ctx.lineCap = "round";
      ctx.beginPath();
      ctx.moveTo(680, 580);
      ctx.bezierCurveTo(760, 590, 840, 570, 920, 585);
      ctx.stroke();

      // Tharsis Volcanic Rise & Olympus Mons (Largest volcano in Solar System)
      ctx.fillStyle = "#632717";
      ctx.beginPath();
      ctx.arc(660, 420, 42, 0, Math.PI * 2); // Olympus Mons shield
      ctx.fill();
      ctx.fillStyle = "#2b0d05";
      ctx.beginPath();
      ctx.arc(660, 420, 12, 0, Math.PI * 2); // Caldera
      ctx.fill();

      // Tharsis Montes Trio (Ascraeus, Pavonis, Arsia Mons)
      for (const [vx, vy] of [[730, 390], [710, 450], [690, 510]]) {
        ctx.fillStyle = "#5c2414";
        ctx.beginPath();
        ctx.arc(vx, vy, 24, 0, Math.PI * 2);
        ctx.fill();
      }

      // Hellas Impact Basin (Giant pale circular depression)
      ctx.fillStyle = "#c97449";
      ctx.beginPath();
      ctx.ellipse(1420, 710, 110, 80, 0.1, 0, Math.PI * 2);
      ctx.fill();

      // Bright Polar Ice Caps (Planum Boreum & Planum Australe)
      ctx.fillStyle = "#ffffff";
      ctx.shadowColor = "#ffffff";
      ctx.shadowBlur = 6;
      ctx.fillRect(0, 0, canvas.width, 38);   // North Cap
      ctx.fillRect(0, 986, canvas.width, 38); // South Cap
      ctx.shadowBlur = 0;

      return new THREE.CanvasTexture(canvas);
    }

    // 4. REALISTIC MOON PROCEDURAL TEXTURE (Calibrated tone - NO WASHED OUT WHITE!)
    function createRealisticMoonTexture() {
      const canvas = document.createElement("canvas");
      canvas.width = 2048;
      canvas.height = 1024;
      const ctx = canvas.getContext("2d");

      // Anorthositic Lunar Highlands Base (Silvery Medium-Grey)
      ctx.fillStyle = "#646d7a";
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Multi-scale 3D micro-craters across the entire lunar crust
      for (let i = 0; i < 900; i++) {
        const x = Math.random() * canvas.width;
        const y = Math.random() * canvas.height;
        const rad = 1.8 + Math.random() * 8.5;

        // Shadowed floor (crater interior)
        ctx.fillStyle = "#3e4754";
        ctx.beginPath();
        ctx.arc(x, y, rad, 0, Math.PI * 2);
        ctx.fill();

        // Sunlit raised rim
        ctx.fillStyle = "#8a94a3";
        ctx.beginPath();
        ctx.arc(x - rad * 0.25, y - rad * 0.25, rad * 0.65, 0, Math.PI * 2);
        ctx.fill();
      }

      // Dark Basaltic Lunar Maria (Lava Plains) - Deep Slate Basalt
      ctx.fillStyle = "#27313f";
      // Oceanus Procellarum (Ocean of Storms)
      ctx.beginPath();
      ctx.ellipse(680, 440, 210, 160, -0.1, 0, Math.PI * 2);
      ctx.fill();

      // Mare Imbrium (Sea of Rains)
      ctx.beginPath();
      ctx.arc(980, 340, 130, 0, Math.PI * 2);
      ctx.fill();

      // Mare Serenitatis & Mare Tranquillitatis (Apollo 11 Base Tranquilidad!)
      ctx.beginPath();
      ctx.ellipse(1160, 360, 95, 75, 0, 0, Math.PI * 2);
      ctx.ellipse(1220, 470, 110, 85, 0.1, 0, Math.PI * 2);
      ctx.fill();

      // Mare Crisium (Circular Sea of Crises)
      ctx.beginPath();
      ctx.ellipse(1380, 410, 70, 55, 0, 0, Math.PI * 2);
      ctx.fill();

      // Mare Nubium & Mare Fecunditatis
      ctx.beginPath();
      ctx.ellipse(920, 600, 90, 70, 0, 0, Math.PI * 2);
      ctx.ellipse(1310, 570, 85, 70, 0, 0, Math.PI * 2);
      ctx.fill();

      // TYCHO CRATER & SPECTACULAR BRIGHT RAY SYSTEM (Southern Highlands)
      ctx.save();
      ctx.strokeStyle = "rgba(226, 232, 240, 0.45)";
      ctx.lineWidth = 2.2;
      const tychoX = 1050;
      const tychoY = 740;
      // 24 Ejecta rays spreading across the southern hemisphere
      for (let a = 0; a < Math.PI * 2; a += Math.PI / 12) {
        ctx.beginPath();
        ctx.moveTo(tychoX, tychoY);
        ctx.lineTo(tychoX + Math.cos(a) * 480, tychoY + Math.sin(a) * 480);
        ctx.stroke();
      }
      // Bright Tycho Crater Core
      ctx.fillStyle = "#f8fafc";
      ctx.beginPath();
      ctx.arc(tychoX, tychoY, 15, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();

      // Copernicus Crater Ray Halo
      ctx.fillStyle = "#cbd5e1";
      ctx.beginPath();
      ctx.arc(910, 460, 14, 0, Math.PI * 2);
      ctx.fill();

      // Shackleton Crater at South Pole
      ctx.fillStyle = "#0f172a"; // Deep shadow
      ctx.beginPath();
      ctx.arc(1024, 1010, 15, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = "#e2e8f0"; // Illuminated rim
      ctx.lineWidth = 3;
      ctx.stroke();

      return new THREE.CanvasTexture(canvas);
    }

    // --- COORDINATE PROJECTION TO SPHERE ---
    function latLngToVector3(lat, lng, radius) {
      const phi = (90 - lat) * (Math.PI / 180);
      const theta = (lng + 180) * (Math.PI / 180);
      const x = -(radius * Math.sin(phi) * Math.cos(theta));
      const z = radius * Math.sin(phi) * Math.sin(theta);
      const y = radius * Math.cos(phi);
      return new THREE.Vector3(x, y, z);
    }

    // --- POPULATE PINS & RADAR PULSES ---
    function populateEarthPins() {
      while (earthPinsGroup.children.length > 0) {
        earthPinsGroup.remove(earthPinsGroup.children[0]);
      }
      earthPulseRings = [];

      (DB.earth_analogs || []).forEach(analog => {
        const pos = latLngToVector3(analog.coordinates.lat, analog.coordinates.lng, 71.5);
        const isBolivia = analog.is_bolivian_gem;
        const pinColor = isBolivia ? 0xfbbf24 : 0x00f2fe;

        // Core Glowing Pin Sphere
        const pinGeo = new THREE.SphereGeometry(isBolivia ? 2.4 : 1.8, 16, 16);
        const pinMat = new THREE.MeshBasicMaterial({ color: pinColor });
        const pinMesh = new THREE.Mesh(pinGeo, pinMat);
        pinMesh.position.copy(pos);
        pinMesh.userData = { type: "earth", data: analog };

        // Ground Radar Ring
        const ringGeo = new THREE.RingGeometry(2.4, 3.6, 24);
        const ringMat = new THREE.MeshBasicMaterial({
          color: isBolivia ? 0xef4444 : 0x00f2fe,
          side: THREE.DoubleSide,
          transparent: true,
          opacity: 0.8
        });
        const ringMesh = new THREE.Mesh(ringGeo, ringMat);
        ringMesh.position.copy(pos.clone().multiplyScalar(1.01));
        ringMesh.lookAt(new THREE.Vector3(0, 0, 0));
        earthPinsGroup.add(ringMesh);
        earthPulseRings.push(ringMesh);

        earthPinsGroup.add(pinMesh);
      });
    }

    function populateTargetPins() {
      while (targetPinsGroup.children.length > 0) {
        targetPinsGroup.remove(targetPinsGroup.children[0]);
      }
      targetPulseRings = [];

      const sitesObj = (activeTargetPlanet === "mars") ? DB.mars_sites : DB.moon_sites;
      const pinColor = (activeTargetPlanet === "mars") ? 0xf97316 : 0x38bdf8;

      Object.values(sitesObj || {}).forEach(site => {
        const pos = latLngToVector3(site.coordinates.lat, site.coordinates.lng, 71.5);
        const pinGeo = new THREE.SphereGeometry(2.3, 16, 16);
        const pinMat = new THREE.MeshBasicMaterial({ color: pinColor });
        const pinMesh = new THREE.Mesh(pinGeo, pinMat);
        pinMesh.position.copy(pos);
        pinMesh.userData = { type: "target", data: site };

        // Outer Radar Ring
        const ringGeo = new THREE.RingGeometry(2.4, 3.6, 24);
        const ringMat = new THREE.MeshBasicMaterial({
          color: pinColor,
          side: THREE.DoubleSide,
          transparent: true,
          opacity: 0.8
        });
        const ringMesh = new THREE.Mesh(ringGeo, ringMat);
        ringMesh.position.copy(pos.clone().multiplyScalar(1.01));
        ringMesh.lookAt(new THREE.Vector3(0, 0, 0));
        targetPinsGroup.add(ringMesh);
        targetPulseRings.push(ringMesh);

        targetPinsGroup.add(pinMesh);
      });
    }

    // --- INTERACTION & CLICK HANDLERS ---
    function handleGlobeClick(event, globeType) {
      const container = (globeType === "earth") 
        ? document.getElementById("canvas-earth") 
        : document.getElementById("canvas-target");
      const rect = container.getBoundingClientRect();

      mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
      mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;

      const currentCamera = (globeType === "earth") ? cameraEarth : cameraTarget;
      const currentPins = (globeType === "earth") ? earthPinsGroup : targetPinsGroup;

      raycaster.setFromCamera(mouse, currentCamera);
      const intersects = raycaster.intersectObjects(currentPins.children, false);

      if (intersects.length > 0) {
        const hitObj = intersects[0].object;
        const clicked = hitObj.userData;
        if (!clicked || !clicked.data) return;

        lastClickedPinData = clicked.data;
        lastClickedPinType = globeType;
        lastClickedPos3D = hitObj.position.clone();

        if (globeType === "earth") {
          selectedEarthAnalog = clicked.data;
          focusEarthOnCoords(selectedEarthAnalog.coordinates.lat, selectedEarthAnalog.coordinates.lng);

          // Auto-select best matching site on Mars/Moon
          const topMatch = selectedEarthAnalog.top_matching_destinations && selectedEarthAnalog.top_matching_destinations[0];
          if (topMatch) {
            const isMars = !!DB.mars_sites[topMatch.target_id];
            if (isMars && activeTargetPlanet !== "mars") {
              setTargetPlanet("mars");
            } else if (!isMars && activeTargetPlanet !== "moon") {
              setTargetPlanet("moon");
            }
            selectedTargetSite = DB.mars_sites[topMatch.target_id] || DB.moon_sites[topMatch.target_id] || selectedTargetSite;
            if (selectedTargetSite) {
              focusTargetOnCoords(selectedTargetSite.coordinates.lat, selectedTargetSite.coordinates.lng);
            }
          }
        } else {
          selectedTargetSite = clicked.data;
          focusTargetOnCoords(selectedTargetSite.coordinates.lat, selectedTargetSite.coordinates.lng);

          const bestList = selectedTargetSite.best_earth_analogs || [];
          if (bestList.length > 0) {
            const matchId = bestList[0];
            const foundAnalog = (DB.earth_analogs || []).find(a => a.id === matchId);
            if (foundAnalog) {
              selectedEarthAnalog = foundAnalog;
              focusEarthOnCoords(selectedEarthAnalog.coordinates.lat, selectedEarthAnalog.coordinates.lng);
            }
          }
        }

        updateHUD();
        showCallout(event.clientX, event.clientY, clicked.data, globeType);
      }
    }

    function handleGlobeHover(event, globeType) {
      const container = (globeType === "earth") 
        ? document.getElementById("canvas-earth") 
        : document.getElementById("canvas-target");
      const rect = container.getBoundingClientRect();

      mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
      mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;

      const currentCamera = (globeType === "earth") ? cameraEarth : cameraTarget;
      const currentPins = (globeType === "earth") ? earthPinsGroup : targetPinsGroup;

      raycaster.setFromCamera(mouse, currentCamera);
      const intersects = raycaster.intersectObjects(currentPins.children, false);

      const tooltip = document.getElementById("globe-tooltip");
      if (intersects.length > 0) {
        const hit = intersects[0].object.userData.data;
        if (hit) {
          tooltip.style.display = "block";
          tooltip.style.left = (event.clientX + 14) + "px";
          tooltip.style.top = (event.clientY - 30) + "px";
          tooltip.innerHTML = `<strong>${hit.name}</strong><br><span style="color:#00f2fe;">${hit.country || hit.mission || ""}</span><br><span style="color:#22c55e; font-size:0.65rem;">📷 Clic para ver mapas e imágenes</span>`;
          document.body.style.cursor = "pointer";
          return;
        }
      }
      tooltip.style.display = "none";
      document.body.style.cursor = "default";
    }

    // --- ON-GLOBE CALLOUT ---
    function showCallout(screenX, screenY, data, type) {
      const callout = document.getElementById("globe-pin-callout");
      const title = document.getElementById("callout-title");
      const thumb = document.getElementById("callout-thumb");
      const typeEl = document.getElementById("callout-type");
      const coordsEl = document.getElementById("callout-coords");

      title.textContent = data.name;
      thumb.src = `data/processed/satellite_textures/texture_${data.id}.png`;
      thumb.onerror = () => { thumb.src = `data/processed/heightmaps/heightmap_${data.id}.png`; };

      if (type === "earth") {
        typeEl.textContent = data.is_bolivian_gem ? "🇧🇴 Joya de Bolivia" : data.country.toUpperCase();
        coordsEl.textContent = `${data.coordinates.elevation_m} msnm • Lat ${data.coordinates.lat.toFixed(2)}°`;
      } else {
        typeEl.textContent = data.body.toUpperCase();
        coordsEl.textContent = `${data.mission || ""} • Lat ${data.coordinates.lat.toFixed(2)}°`;
      }

      callout.style.left = screenX + "px";
      callout.style.top = screenY + "px";
      callout.style.display = "block";
    }

    function closeCallout() {
      document.getElementById("globe-pin-callout").style.display = "none";
    }

    function openModalFromCallout() {
      if (lastClickedPinData) {
        openSiteModal(lastClickedPinType);
      }
    }

    let autoRotateEarth = true;
    let autoRotateTarget = true;
    let pauseEarthSpinTimeout = null;
    let pauseTargetSpinTimeout = null;

    // --- SMOOTH CAMERA ROTATION & COORDINATE TRACKING ---
    function focusEarthOnCoords(lat, lng) {
      autoRotateEarth = false;
      clearTimeout(pauseEarthSpinTimeout);
      pauseEarthSpinTimeout = setTimeout(() => { autoRotateEarth = true; }, 14000);

      const localPos = latLngToVector3(lat, lng, 230);
      const worldPos = localPos.clone().applyAxisAngle(new THREE.Vector3(0, 1, 0), globeEarth.rotation.y);
      animateCameraTo(cameraEarth, controlsEarth, worldPos);
    }

    function focusTargetOnCoords(lat, lng) {
      autoRotateTarget = false;
      clearTimeout(pauseTargetSpinTimeout);
      pauseTargetSpinTimeout = setTimeout(() => { autoRotateTarget = true; }, 14000);

      const localPos = latLngToVector3(lat, lng, 230);
      const worldPos = localPos.clone().applyAxisAngle(new THREE.Vector3(0, 1, 0), globeTarget.rotation.y);
      animateCameraTo(cameraTarget, controlsTarget, worldPos);
    }

    function animateCameraTo(cam, ctrl, endPos) {
      const startPos = cam.position.clone();
      let t = 0;
      function step() {
        t += 0.045;
        if (t <= 1.0) {
          cam.position.lerpVectors(startPos, endPos, t);
          ctrl.update();
          requestAnimationFrame(step);
        } else {
          cam.position.copy(endPos);
          ctrl.update();
        }
      }
      step();
    }

    // --- MAP TAB SWITCHERS IN HUD ---
    function setupMapTabHandlers() {
      // Earth map tabs
      document.querySelectorAll("#earth-map-tabs .map-tab-btn").forEach(btn => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          document.querySelectorAll("#earth-map-tabs .map-tab-btn").forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          activeEarthMapType = btn.dataset.map;
          updateEarthMapImage();
        });
      });

      // Target map tabs
      document.querySelectorAll("#target-map-tabs .map-tab-btn").forEach(btn => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          document.querySelectorAll("#target-map-tabs .map-tab-btn").forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          activeTargetMapType = btn.dataset.map;
          updateTargetMapImage();
        });
      });
    }

    function updateEarthMapImage() {
      if (!selectedEarthAnalog) return;
      const img = document.getElementById("earth-map-img");
      const badge = document.getElementById("earth-map-badge");
      const id = selectedEarthAnalog.id;

      if (activeEarthMapType === "satellite") {
        img.src = `data/processed/satellite_textures/texture_${id}.png`;
        badge.textContent = "🛰️ Sentinel-2 / Landsat-9";
      } else if (activeEarthMapType === "heightmap") {
        img.src = `data/processed/heightmaps/heightmap_${id}.png`;
        badge.textContent = "🗺️ DEM Altimetría Láser";
      } else {
        img.src = `data/processed/slope_maps/slopemap_${id}.png`;
        badge.textContent = "⚠️ Riesgo Pendientes Locomoción";
      }
    }

    function updateTargetMapImage() {
      if (!selectedTargetSite) return;
      const img = document.getElementById("target-map-img");
      const badge = document.getElementById("target-map-badge");
      const id = selectedTargetSite.id;
      const isMars = selectedTargetSite.body === "Mars";

      if (activeTargetMapType === "satellite") {
        img.src = `data/processed/satellite_textures/texture_${id}.png`;
        badge.textContent = isMars ? "🛰️ NASA HiRISE 50cm" : "🛰️ NASA LRO NAC";
      } else if (activeTargetMapType === "heightmap") {
        img.src = `data/processed/heightmaps/heightmap_${id}.png`;
        badge.textContent = isMars ? "🗺️ DEM MOLA / HRSC" : "🗺️ DEM LOLA Altimetría";
      } else {
        img.src = `data/processed/slope_maps/slopemap_${id}.png`;
        badge.textContent = "⚠️ Riesgo de Locomoción Rover";
      }
    }

    // --- UPDATE MISSION INTELLIGENCE HUD ---
    function updateHUD() {
      if (!selectedEarthAnalog || !selectedTargetSite) return;

      // 1. Earth Analog Card
      const eBadge = document.getElementById("earth-badge");
      if (selectedEarthAnalog.is_bolivian_gem) {
        eBadge.className = "site-badge badge-bolivia-gem";
        eBadge.textContent = "🇧🇴 JOYA DE BOLIVIA";
      } else {
        eBadge.className = "site-badge";
        eBadge.style.background = "#0284c7";
        eBadge.textContent = selectedEarthAnalog.country.toUpperCase();
      }
      document.getElementById("earth-name").textContent = selectedEarthAnalog.name;
      document.getElementById("earth-coords").textContent = 
        `${selectedEarthAnalog.region}, ${selectedEarthAnalog.country} • ${selectedEarthAnalog.coordinates.elevation_m} msnm (${selectedEarthAnalog.coordinates.lat.toFixed(2)}°, ${selectedEarthAnalog.coordinates.lng.toFixed(2)}°)`;
      document.getElementById("earth-gases").textContent = 
        `Presión: ${selectedEarthAnalog.gases_atmosphere.pressure_kpa} kPa • ${selectedEarthAnalog.gases_atmosphere.density_comparison}`;
      document.getElementById("earth-minerals").textContent = 
        selectedEarthAnalog.mineralogy.predominant.slice(0, 4).join(", ");
      document.getElementById("earth-climate").textContent = 
        `T: ${selectedEarthAnalog.climate_radiation.temp_min_c}°C a ${selectedEarthAnalog.climate_radiation.temp_max_c}°C • UV: ${selectedEarthAnalog.climate_radiation.uv_index} • Pendiente: ${selectedEarthAnalog.surface_roughness.mean_slope_deg}°`;

      updateEarthMapImage();

      // 2. Extraterrestrial Target Card
      const tBadge = document.getElementById("target-badge");
      if (selectedTargetSite.body === "Mars") {
        tBadge.className = "site-badge badge-mars";
        tBadge.textContent = "MARTE";
        document.getElementById("target-map-label").textContent = "🛰️ FOTOGRAFÍA ORBITAL NASA:";
        document.getElementById("target-map-label").style.color = "var(--mars-color)";
      } else {
        tBadge.className = "site-badge badge-moon";
        tBadge.textContent = "LUNA";
        document.getElementById("target-map-label").textContent = "🛰️ MAPEADOR LUNAR LRO:";
        document.getElementById("target-map-label").style.color = "var(--moon-color)";
      }
      document.getElementById("target-name").textContent = selectedTargetSite.name;
      document.getElementById("target-mission").textContent = `${selectedTargetSite.mission} (${selectedTargetSite.type})`;
      document.getElementById("target-gases").textContent = 
        `Presión: ${selectedTargetSite.gases_atmosphere.pressure_kpa} kPa • ${selectedTargetSite.gases_atmosphere.composition.slice(0, 50)}...`;
      document.getElementById("target-minerals").textContent = 
        selectedTargetSite.mineralogy.predominant.slice(0, 4).join(", ");
      document.getElementById("target-climate").textContent = 
        `T: ${selectedTargetSite.climate_radiation.temp_min_c}°C a ${selectedTargetSite.climate_radiation.temp_max_c}°C • Radiación: ${selectedTargetSite.climate_radiation.radiation_dose_msv_yr} mSv/año`;

      updateTargetMapImage();

      // 3. PSI Score Calculation & Breakdown
      const simEntry = selectedEarthAnalog.target_similarity_scores && selectedEarthAnalog.target_similarity_scores[selectedTargetSite.id];
      const psiVal = simEntry ? simEntry.overall_psi : 75.0;
      const sub = simEntry ? simEntry.subscores : { topography: 85, mineralogy: 65, environment: 78 };
      const tierText = simEntry ? simEntry.match_tier : "Tier 2: High-Fidelity Planetary Analog";

      document.getElementById("psi-score").textContent = Math.round(psiVal) + "%";
      document.getElementById("psi-circle").style.background = 
        `conic-gradient(var(--accent) 0deg, var(--accent) ${psiVal * 3.6}deg, rgba(255,255,255,0.1) ${psiVal * 3.6}deg)`;
      document.getElementById("psi-tier").textContent = tierText;

      document.getElementById("sub-topo").textContent = Math.round(sub.topography) + "%";
      document.getElementById("bar-topo").style.width = sub.topography + "%";

      document.getElementById("sub-min").textContent = Math.round(sub.mineralogy) + "%";
      document.getElementById("bar-min").style.width = sub.mineralogy + "%";

      document.getElementById("sub-env").textContent = Math.round(sub.environment) + "%";
      document.getElementById("bar-env").style.width = sub.environment + "%";

      // 4. Mission Preparation & Habitat Gear Lists
      const gearUl = document.getElementById("gear-list");
      gearUl.innerHTML = "";
      (selectedTargetSite.mission_equipment_needed || []).slice(0, 3).forEach(item => {
        const li = document.createElement("li");
        li.className = "gear-item";
        li.innerHTML = `<span class="gear-bullet">►</span> ${item}`;
        gearUl.appendChild(li);
      });

      const habUl = document.getElementById("habitat-list");
      habUl.innerHTML = "";
      (selectedTargetSite.habitat_conditioning || []).slice(0, 3).forEach(item => {
        const li = document.createElement("li");
        li.className = "gear-item";
        li.innerHTML = `<span class="gear-bullet">★</span> ${item}`;
        habUl.appendChild(li);
      });
    }

    // --- FULLSCREEN MODAL INSPECTOR LOGIC ---
    function openSiteModal(type) {
      modalCurrentType = type;
      modalCurrentSite = (type === "earth") ? selectedEarthAnalog : selectedTargetSite;
      modalCurrentMap = "satellite";

      const modal = document.getElementById("site-modal");
      const title = document.getElementById("modal-site-title");
      const subtitle = document.getElementById("modal-site-subtitle");
      const badge = document.getElementById("modal-site-badge");

      if (type === "earth") {
        title.innerHTML = `🛰️ ${modalCurrentSite.name.toUpperCase()} <span id="modal-site-badge" class="site-badge ${modalCurrentSite.is_bolivian_gem ? 'badge-bolivia-gem' : ''}">${modalCurrentSite.country}</span>`;
        subtitle.textContent = `Análogo Terrestre • ${modalCurrentSite.region}, ${modalCurrentSite.country}`;
        document.getElementById("modal-coords").textContent = `${modalCurrentSite.coordinates.lat.toFixed(4)}°, ${modalCurrentSite.coordinates.lng.toFixed(4)}° • Elevación: ${modalCurrentSite.coordinates.elevation_m} msnm`;
        document.getElementById("modal-roughness").textContent = `Desnivel Máximo: ${modalCurrentSite.surface_roughness.peak_valley_relief_m}m • Pendiente Media: ${modalCurrentSite.surface_roughness.mean_slope_deg}°`;
        document.getElementById("modal-safety").textContent = `✔ 96.5% Superficie Transitable para Rovers Autónomos`;
        document.getElementById("modal-minerals").textContent = modalCurrentSite.mineralogy.predominant.join(", ");
        document.getElementById("modal-summary").textContent = modalCurrentSite.scientific_summary;

        const gearList = document.getElementById("modal-gear-list");
        gearList.innerHTML = "";
        (modalCurrentSite.mission_equipment_needed || []).forEach(gear => {
          const li = document.createElement("li");
          li.className = "gear-item";
          li.innerHTML = `<span class="gear-bullet">►</span> ${gear}`;
          gearList.appendChild(li);
        });

        document.getElementById("modal-counterpart").textContent = `Contraparte: ${selectedTargetSite.name} (${selectedTargetSite.body})`;
      } else {
        const isMars = modalCurrentSite.body === "Mars";
        title.innerHTML = `🛰️ ${modalCurrentSite.name.toUpperCase()} <span id="modal-site-badge" class="site-badge ${isMars ? 'badge-mars' : 'badge-moon'}">${modalCurrentSite.body.toUpperCase()}</span>`;
        subtitle.textContent = `Destino Planetario • ${modalCurrentSite.mission}`;
        document.getElementById("modal-coords").textContent = `${modalCurrentSite.coordinates.lat.toFixed(4)}°, ${modalCurrentSite.coordinates.lng.toFixed(4)}° • Elevación: ${modalCurrentSite.elevation_m} m`;
        document.getElementById("modal-roughness").textContent = `Pendiente Media: ${modalCurrentSite.surface_roughness.mean_slope_deg}° • Rugosidad: ${modalCurrentSite.surface_roughness.roughness_std_m}m`;
        document.getElementById("modal-safety").textContent = isMars ? `Tránsito Rover: Apto con precaución en dunas` : `Tránsito Lunar: Precaución extrema en taludes de impacto`;
        document.getElementById("modal-minerals").textContent = modalCurrentSite.mineralogy.predominant.join(", ");
        document.getElementById("modal-summary").textContent = modalCurrentSite.summary;

        const gearList = document.getElementById("modal-gear-list");
        gearList.innerHTML = "";
        (modalCurrentSite.mission_equipment_needed || []).forEach(gear => {
          const li = document.createElement("li");
          li.className = "gear-item";
          li.innerHTML = `<span class="gear-bullet">►</span> ${gear}`;
          gearList.appendChild(li);
        });

        document.getElementById("modal-counterpart").textContent = `Análogo Terrestre Recomendado: ${selectedEarthAnalog.name} (Bolivia/Global)`;
      }

      switchModalMap("satellite");
      modal.style.display = "flex";
    }

    function switchModalMap(mapType) {
      modalCurrentMap = mapType;
      document.querySelectorAll(".modal-tab-btn").forEach(b => b.classList.remove("active"));

      const displayImg = document.getElementById("modal-img-display");
      const legendTitle = document.getElementById("legend-title");
      const legendContent = document.getElementById("legend-content");
      const legendColors = document.getElementById("legend-colors");
      const id = modalCurrentSite.id;

      if (mapType === "satellite") {
        document.getElementById("modal-tab-sat").classList.add("active");
        displayImg.src = `data/processed/satellite_textures/texture_${id}.png`;
        legendTitle.textContent = "🛰️ Fotografía Satelital / Mapeo Óptico Orbital";
        legendContent.textContent = "Textura multiespectral RGB en alta resolución que identifica facies minerales, regolito y reflectancia.";
        legendColors.style.display = "none";
      } else if (mapType === "heightmap") {
        document.getElementById("modal-tab-dem").classList.add("active");
        displayImg.src = `data/processed/heightmaps/heightmap_${id}.png`;
        legendTitle.textContent = "🗺️ Modelo Digital de Elevación (DEM 3D)";
        legendContent.textContent = "Mapa de desplazamiento altimétrico en escala de grises calibrado para modelado 3D de terreno (blanco = cota máxima, negro = cota mínima).";
        legendColors.style.display = "none";
      } else {
        document.getElementById("modal-tab-slope").classList.add("active");
        displayImg.src = `data/processed/slope_maps/slopemap_${id}.png`;
        legendTitle.textContent = "⚠️ Mapa Analítico de Pendientes y Riesgo de Locomoción Rover";
        legendContent.textContent = "Clasificación cuantitativa de seguridad de tránsito superficial de acuerdo a protocolos NASA JPL:";
        legendColors.style.display = "flex";
      }
    }

    function closeSiteModal() {
      document.getElementById("site-modal").style.display = "none";
    }

    function onModalBackdropClick(e) {
      if (e.target.id === "site-modal") {
        closeSiteModal();
      }
    }

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closeSiteModal();
        closeCallout();
      }
    });

    // --- PLANET SELECTOR TOGGLE ---
    function setTargetPlanet(planet) {
      activeTargetPlanet = planet;
      const btnMars = document.getElementById("btn-mars");
      const btnMoon = document.getElementById("btn-moon");
      const title = document.getElementById("target-globe-title");
      const sub = document.getElementById("target-globe-sub");
      const ambLight = sceneTarget.getObjectByName("target-amb-light");
      const rimLight = sceneTarget.getObjectByName("target-rim-light");

      const atmoMesh = sceneTarget.getObjectByName("target-atmo-mesh");

      if (planet === "mars") {
        btnMars.classList.add("active");
        btnMoon.classList.remove("active");
        title.innerHTML = "🔴 Planeta Marte";
        title.style.color = "var(--mars-color)";
        sub.textContent = "Sitios de Rovers, Misiones Activas y Futuras Bases";

        if (ambLight) ambLight.intensity = 0.42;
        if (rimLight) {
          rimLight.color.setHex(0xf97316);
          rimLight.intensity = 0.25;
        }
        if (atmoMesh) atmoMesh.visible = true;

        globeTarget.material.map = createRealisticMarsTexture();
        globeTarget.material.bumpScale = 1.8;
        globeTarget.material.specular = new THREE.Color(0x331100);
        globeTarget.material.shininess = 4;
        globeTarget.material.needsUpdate = true;

        textureLoader.load(
          "https://raw.githubusercontent.com/mrdoob/three.js/master/examples/textures/planets/mars_1k_color.jpg",
          (tex) => {
            if (activeTargetPlanet === "mars") {
              globeTarget.material.map = tex;
              globeTarget.material.specular = new THREE.Color(0x331100);
              globeTarget.material.shininess = 4;
              globeTarget.material.needsUpdate = true;
            }
          }
        );

        selectedTargetSite = DB.mars_sites["jezero_crater"] || Object.values(DB.mars_sites)[0];
      } else {
        btnMoon.classList.add("active");
        btnMars.classList.remove("active");
        title.innerHTML = "⚪ Satélite Luna";
        title.style.color = "var(--moon-color)";
        sub.textContent = "Misiones Apollo Históricas y Base Sur Artemis III";

        // Moon has NO atmosphere - dramatic space contrast!
        if (ambLight) ambLight.intensity = 0.40;
        if (rimLight) {
          rimLight.color.setHex(0x94a3b8);
          rimLight.intensity = 0.20;
        }
        if (atmoMesh) atmoMesh.visible = false; // Hide atmospheric haze on Moon!

        globeTarget.material.map = createRealisticMoonTexture();
        globeTarget.material.bumpScale = 1.4;
        // CRITICAL: Specular set to 0x000000 ensures lunar regolith NEVER washes out to white!
        globeTarget.material.specular = new THREE.Color(0x000000);
        globeTarget.material.shininess = 0;
        globeTarget.material.needsUpdate = true;

        textureLoader.load(
          "https://raw.githubusercontent.com/mrdoob/three.js/master/examples/textures/planets/moon_1024.jpg",
          (tex) => {
            if (activeTargetPlanet === "moon") {
              globeTarget.material.map = tex;
              globeTarget.material.specular = new THREE.Color(0x000000);
              globeTarget.material.shininess = 0;
              globeTarget.material.needsUpdate = true;
            }
          }
        );

        selectedTargetSite = DB.moon_sites["shackleton_crater"] || Object.values(DB.moon_sites)[0];
      }

      populateTargetPins();
      if (selectedTargetSite) {
        focusTargetOnCoords(selectedTargetSite.coordinates.lat, selectedTargetSite.coordinates.lng);
      }
      updateHUD();
    }

    document.getElementById("btn-mars").addEventListener("click", () => setTargetPlanet("mars"));
    document.getElementById("btn-moon").addEventListener("click", () => setTargetPlanet("moon"));

    // --- SEARCH AND FILTER LOGIC ---
    const searchInput = document.getElementById("region-search");
    searchInput.addEventListener("input", (e) => {
      const q = e.target.value.toLowerCase().trim();
      if (!q) return;

      const matchEarth = (DB.earth_analogs || []).find(a => 
        a.name.toLowerCase().includes(q) || 
        a.country.toLowerCase().includes(q) || 
        a.region.toLowerCase().includes(q)
      );

      if (matchEarth) {
        selectedEarthAnalog = matchEarth;
        focusEarthOnCoords(matchEarth.coordinates.lat, matchEarth.coordinates.lng);
        updateHUD();
        return;
      }

      const matchMars = Object.values(DB.mars_sites || {}).find(m => m.name.toLowerCase().includes(q) || m.mission.toLowerCase().includes(q));
      if (matchMars) {
        if (activeTargetPlanet !== "mars") setTargetPlanet("mars");
        selectedTargetSite = matchMars;
        focusTargetOnCoords(matchMars.coordinates.lat, matchMars.coordinates.lng);
        updateHUD();
        return;
      }

      const matchMoon = Object.values(DB.moon_sites || {}).find(m => m.name.toLowerCase().includes(q) || m.mission.toLowerCase().includes(q));
      if (matchMoon) {
        if (activeTargetPlanet !== "moon") setTargetPlanet("moon");
        selectedTargetSite = matchMoon;
        focusTargetOnCoords(matchMoon.coordinates.lat, matchMoon.coordinates.lng);
        updateHUD();
      }
    });

    document.querySelectorAll(".pill-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".pill-btn").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        const filter = btn.dataset.filter;

        if (filter === "bolivia") {
          const uyuni = (DB.earth_analogs || []).find(a => a.id === "salar_de_uyuni");
          if (uyuni) {
            selectedEarthAnalog = uyuni;
            focusEarthOnCoords(uyuni.coordinates.lat, uyuni.coordinates.lng);
          }
        } else if (filter === "volcano") {
          const sajama = (DB.earth_analogs || []).find(a => a.id === "nevado_sajama" || a.id === "sol_de_manana");
          if (sajama) {
            selectedEarthAnalog = sajama;
            focusEarthOnCoords(sajama.coordinates.lat, sajama.coordinates.lng);
          }
        } else if (filter === "cryo") {
          const mcmurdo = (DB.earth_analogs || []).find(a => a.id === "mcmurdo_dry_valleys");
          if (mcmurdo) {
            selectedEarthAnalog = mcmurdo;
            focusEarthOnCoords(mcmurdo.coordinates.lat, mcmurdo.coordinates.lng);
          }
        } else if (filter === "sal") {
          const uyuni = (DB.earth_analogs || []).find(a => a.id === "salar_de_uyuni" || a.id === "atacama_yungay");
          if (uyuni) {
            selectedEarthAnalog = uyuni;
            focusEarthOnCoords(uyuni.coordinates.lat, uyuni.coordinates.lng);
          }
        }
        updateHUD();
      });
    });

    // --- ANIMATION LOOP & RESIZE ---
    function onWindowResize() {
      const eContainer = document.getElementById("canvas-earth");
      cameraEarth.aspect = eContainer.clientWidth / eContainer.clientHeight;
      cameraEarth.updateProjectionMatrix();
      rendererEarth.setSize(eContainer.clientWidth, eContainer.clientHeight);

      const tContainer = document.getElementById("canvas-target");
      cameraTarget.aspect = tContainer.clientWidth / tContainer.clientHeight;
      cameraTarget.updateProjectionMatrix();
      rendererTarget.setSize(tContainer.clientWidth, tContainer.clientHeight);
    }

    function animate() {
      requestAnimationFrame(animate);

      const time = performance.now() * 0.002;

      // Slow cinematic idle planetary spin
      if (autoRotateEarth && (!controlsEarth.state || controlsEarth.state === -1)) {
        globeEarth.rotation.y += 0.0004;
      }
      if (globeEarthClouds) {
        globeEarthClouds.rotation.y += 0.0006; // Clouds drift independently
      }

      if (autoRotateTarget && (!controlsTarget.state || controlsTarget.state === -1)) {
        globeTarget.rotation.y += 0.0004;
      }

      // Radar Sonar Pulse Animation for Pins
      earthPulseRings.forEach((ring, idx) => {
        const cycle = ((time + idx * 0.3) % 1.0);
        const scale = 1.0 + cycle * 0.7;
        ring.scale.set(scale, scale, 1);
        ring.material.opacity = (1.0 - cycle) * 0.8;
      });

      targetPulseRings.forEach((ring, idx) => {
        const cycle = ((time + idx * 0.35) % 1.0);
        const scale = 1.0 + cycle * 0.7;
        ring.scale.set(scale, scale, 1);
        ring.material.opacity = (1.0 - cycle) * 0.8;
      });

      controlsEarth.update();
      controlsTarget.update();

      rendererEarth.render(sceneEarth, cameraEarth);
      rendererTarget.render(sceneTarget, cameraTarget);
    }

    // Initialize when DOM ready
    window.addEventListener("DOMContentLoaded", initDualGlobes);
  </script>
</body>
</html>
